{
  "name": "mud-template-vanilla",
  "private": true,
  "packageManager": "pnpm@9.1.0",
  "scripts": {
    "build": "pnpm recursive run build",
    "dev": "mprocs",
    "dev:client": "pnpm --filter 'client' run dev",
    "dev:contracts": "pnpm --filter 'contracts' dev",
    "foundry:up": "curl -L https://foundry.paradigm.xyz | bash && bash $HOME/.foundry/bin/foundryup",
    "mud:up": "pnpm mud set-version --tag main && pnpm install",
    "prepare": "[ -n \"$CI\" ] || forge --version || pnpm foundry:up",
    "promo:links": "tsx scripts/generatePromoLinks.ts",
    "test": "pnpm recursive run test"
  },
  "devDependencies": {
    "@latticexyz/cli": "2.2.23",
    "@latticexyz/common": "2.2.23",
    "@latticexyz/explorer": "2.2.23",
    "@latticexyz/store-indexer": "2.2.23",
    "@types/debug": "4.1.7",
    "@types/node": "^20",
    "@typescript-eslint/eslint-plugin": "7.1.1",
    "@typescript-eslint/parser": "7.1.1",
    "dotenv": "^17.4.2",
    "eslint": "8.57.0",
    "mprocs": "^0.7.3",
    "shx": "^0.3.4",
    "tsx": "^4.23.12",
    "typescript": "5.4.2",
    "viem": "2.35.1"
  },
  "engines": {
    "node": "^20",
    "pnpm": "^9"
  }
}
