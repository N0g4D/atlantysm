node_modules

# mud artifacts
.mud
# sqlite indexer data
*.db
*.db-journal

# macOS
.DS_Store

# local-only agent settings
.claude/settings.local.json

# secrets. A Sepolia deploy key lives in packages/contracts/.env and must never be committed;
# .env.example carries the placeholders instead.
.env
!.env.example
# packages/client/.env is already tracked on purpose: it holds VITE_CHAIN_ID and nothing secret.
!packages/client/.env

# Promo links. Every line contains a live private key in a query string — this file IS the wallet
# set, and nothing else records those keys. Never commit it.
promo_links.txt
promo_links.csv

# Ignore report logs
*.txt
