# Atlantysm — client environment
#
# Vite only exposes variables prefixed `VITE_`. On Vercel, set these in
# Project Settings -> Environment Variables; a real env var beats the committed `.env`, because
# Vite applies process.env over the file contents (verified in vite 4.5's loadEnv).
#
# The World ADDRESS is not here on purpose. It comes from packages/contracts/worlds.json, which
# `mud deploy` writes and you commit — so a redeploy that changes the address is a diff someone
# can see, rather than a console setting that silently drifts from the code.

# Chain to connect to. 31337 = local anvil (the default when unset), 11155111 = Sepolia.
VITE_CHAIN_ID=11155111

# Sepolia HTTP RPC. Optional but strongly recommended for anything demoed: on load the client
# replays every Store_* log from the World's deploy block, and the free shared endpoint that ships
# as the default will rate-limit that burst.
VITE_SEPOLIA_RPC_HTTP=https://eth-sepolia.g.alchemy.com/v2/<YOUR_KEY>

# Sepolia WebSocket RPC. OPTIONAL, and leave it unset unless the endpoint really works: viem's
# webSocket transport throws when it cannot connect and `fallback` will not fail over to HTTP for
# it, so a wrong value here is a blank page rather than a slow one.
# VITE_SEPOLIA_RPC_WS=wss://eth-sepolia.g.alchemy.com/v2/<YOUR_KEY>
